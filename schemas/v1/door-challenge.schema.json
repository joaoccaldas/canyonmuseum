{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/door-challenge-v1.json",
  "title": "KONA Door Challenge V1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "room_id",
    "opens_at",
    "closes_at",
    "answer",
    "scoring",
    "reward"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "door_mode": {
      "enum": [
        "visible",
        "hinted",
        "secret"
      ]
    },
    "opens_at": {
      "type": "string",
      "format": "date-time"
    },
    "closes_at": {
      "type": "string",
      "format": "date-time"
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "silhouette",
              "sound",
              "crop",
              "year",
              "quote",
              "measurement",
              "material",
              "coordinate",
              "split",
              "colour",
              "brand-detail",
              "text"
            ]
          },
          "value": {}
        },
        "additionalProperties": true
      }
    },
    "answer": {
      "type": "object",
      "properties": {
        "theme": {
          "type": [
            "string",
            "null"
          ]
        },
        "era": {
          "type": [
            "string",
            "null"
          ]
        },
        "discipline": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "scoring": {
      "type": "object",
      "required": [
        "version",
        "weights"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "theme": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "era": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "discipline": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "category": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "family": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reward": {
      "type": "object",
      "required": [
        "totem_id",
        "early_access_band"
      ],
      "properties": {
        "totem_id": {
          "type": "string"
        },
        "early_access_band": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "exact_badge_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_read_badge_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
