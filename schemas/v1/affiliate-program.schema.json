{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/v1/affiliate-program.schema.json",
  "title": "Affiliate Program V1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "brand_id",
    "status",
    "regions",
    "tracking",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^affiliate-program:[a-z0-9:_-]+$"
    },
    "entity_type": {
      "const": "affiliate-program"
    },
    "brand_id": {
      "type": "string",
      "pattern": "^brand:[a-z0-9:_-]+$"
    },
    "status": {
      "enum": [
        "research",
        "application-ready",
        "applied",
        "approved",
        "rejected",
        "paused",
        "closed"
      ]
    },
    "network": {
      "type": [
        "string",
        "null"
      ]
    },
    "application_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commission": {
      "type": "object",
      "properties": {
        "model": {
          "enum": [
            "percentage",
            "fixed",
            "tiered",
            "unknown"
          ]
        },
        "base_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "tracking": {
      "type": "object",
      "properties": {
        "cookie_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "deep_links": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "product_feed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "disclosure_required": {
      "type": "boolean",
      "default": true
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/SourceRef"
      }
    }
  },
  "additionalProperties": false
}
