{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/v1/product.schema.json",
  "title": "Canonical Product V1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "brand",
    "name",
    "category",
    "status",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^product:[a-z0-9:_-]+$"
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "entity_type": {
      "const": "product"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2100
    },
    "category": {
      "enum": [
        "bike",
        "wheel",
        "shoe",
        "helmet",
        "trisuit",
        "watch",
        "wetsuit",
        "nutrition",
        "hydration",
        "sunglasses",
        "component",
        "other"
      ]
    },
    "subtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "validated",
        "published",
        "retired",
        "concept"
      ]
    },
    "specifications": {
      "type": "object",
      "additionalProperties": true
    },
    "geometry": {
      "type": "object",
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "uri"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "glb",
              "blend",
              "image",
              "video",
              "thumbnail",
              "texture",
              "manual",
              "datasheet"
            ]
          },
          "uri": {
            "type": "string"
          },
          "lod": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "rights_status": {
            "enum": [
              "clear",
              "review",
              "blocked",
              "not-applicable"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "inspect",
          "collect",
          "share",
          "customize",
          "equip",
          "visit",
          "compare",
          "buy",
          "simulate"
        ]
      },
      "uniqueItems": true
    },
    "setup_slots": {
      "type": "array",
      "items": {
        "enum": [
          "bike",
          "wheel_front",
          "wheel_rear",
          "helmet",
          "shoe",
          "trisuit",
          "watch",
          "wetsuit",
          "nutrition",
          "hydration",
          "sunglasses"
        ]
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/SourceRef"
      }
    },
    "commercial": {
      "type": "object",
      "properties": {
        "official_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "affiliate_program_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
