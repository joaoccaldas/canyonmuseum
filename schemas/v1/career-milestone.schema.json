{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/v1/career-milestone.schema.json",
  "title": "Career Milestone V1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "athlete_id",
    "date",
    "title",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^career-milestone:[a-z0-9:_-]+$"
    },
    "entity_type": {
      "const": "career-milestone"
    },
    "athlete_id": {
      "type": "string",
      "pattern": "^athlete:[a-z0-9:_-]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1200
    },
    "milestone_type": {
      "enum": [
        "win",
        "podium",
        "record",
        "championship",
        "comeback",
        "injury",
        "sponsor-change",
        "team-change",
        "retirement",
        "other"
      ]
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^event:[a-z0-9:_-]+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/SourceRef"
      }
    }
  },
  "additionalProperties": false
}
