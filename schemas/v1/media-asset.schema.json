{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/v1/media-asset.schema.json",
  "title": "Media Asset V1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "kind",
    "uri",
    "rights",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^media-asset:[a-z0-9:_-]+$"
    },
    "entity_type": {
      "const": "media-asset"
    },
    "kind": {
      "enum": [
        "image",
        "video",
        "audio",
        "3d",
        "document",
        "thumbnail"
      ]
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "alt_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "credit": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "clear",
            "review",
            "blocked",
            "public-domain",
            "open-license",
            "partner-provided"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "commercial_use_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "derivatives_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attribution_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attribution_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/SourceRef"
      }
    }
  },
  "additionalProperties": false
}
